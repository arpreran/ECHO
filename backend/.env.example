# ECHO backend configuration. Copy to backend/.env. The default (Ollama) needs no key; cloud providers need ONE key.
# Keys stay on the backend; the React app never sees them. Never commit .env.

# Conversation model for ECHO Companion: ollama | gemini | openai | anthropic
# ollama runs locally and needs no API key.
ECHO_CHAT_PROVIDER=ollama

# Speech-to-text: browser (Web Speech API in Chrome/Edge, free) | gemini | openai
ECHO_STT_PROVIDER=browser
# Text-to-speech: browser (speechSynthesis, free) | gemini | openai
ECHO_TTS_PROVIDER=browser

# Local Ollama (https://ollama.com). ECHO never downloads models; install with: ollama pull qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=180

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

OPENAI_API_KEY=
# OpenAI-compatible servers also work with ECHO_CHAT_PROVIDER=openai: set the server URL, its key and a model id.
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Sarvam AI:  OPENAI_BASE_URL=https://api.sarvam.ai/v1
# Use the model ids listed by the provider. Free tiers, limits and model names change; check their docs.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5

# Optional
# ECHO_DATABASE_PATH=../database/echo.sqlite3
# ECHO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ECHO_REQUEST_TIMEOUT=60
